#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.postgres/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
dbeaver-sbom.pcs: software bill of materials of the DBeaver Community Edition client, the
optional graphical SQL client of the bedrock capability. It is a file of its own, apart from
postgres-sbom.pcs; dbClients-sbom.pcs, the group sbom of the database clients, pulls it in
through its sbomsList. It runs after that sbom's apt step, so psql is installed before this runs,
and a failure here cannot undo it.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")

ap = pkgsSeed.aptPkg

_keyringPath = "/etc/apt/keyrings/dbeaver.gpg"
_sourcesListPath = "/etc/apt/sources.list.d/dbeaver.list"


def dbeaverAptSource():
    """Add the vendor apt source of DBeaver Community Edition. Not an apt package.

    DBeaver is not in Debian's own apt, so it comes from the vendor repository. Same
    func-bearing pseudo-package mechanism as postgresClusterSetup in postgres-sbom.pcs: it
    runs on *every* sbom_fullUpdate and must stay idempotent. Ordering in aptPkgsList is
    load-bearing: it must come after curl and gnupg, and before ap("dbeaver-ce").

    The key is fetched over https and trusted on first use; its fingerprint is not pinned.
    The source is signed-by that one key only, so it cannot vouch for any other package.
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        f"""
sudo mkdir -p -m 755 /etc/apt/keyrings
if [ ! -s {_keyringPath} ] ; then   # -s: a failed fetch must not leave an empty file that blocks a retry
    curl -fsSL https://dbeaver.io/debs/dbeaver.gpg.key | sudo gpg --dearmor -o {_keyringPath}
    sudo chmod go+r {_keyringPath}
fi
if [ ! -f {_sourcesListPath} ] ; then
    echo "deb [signed-by={_keyringPath}] https://dbeaver.io/debs/dbeaver-ce /" | sudo tee {_sourcesListPath} >/dev/null
    sudo apt-get update
fi
""")
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


aptPkgsList = [
    ap("ca-certificates"),          # https to the vendor
    ap("curl"),                     # fetches the vendor key
    ap("gnupg"),                    # gpg --dearmor of the vendor key
    ap("dbeaverAptSource", func=dbeaverAptSource),
    ap("dbeaver-ce"),               # DBeaver Community Edition, from the vendor source above
]

# No pip packages: DBeaver is a Java application with its own runtime.

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: DBeaver Community Edition -- the optional graphical SQL client of the bedrock
   capability. Part of bisos.postgres; dbClients-sbom.pcs pulls this sbom in.

** What this installs:
  1) apt packages: ca-certificates, curl and gnupg, which the next step needs.
  2) The dbeaverAptSource pseudo-package: the vendor apt source, signed by the vendor key
     only ({_keyringPath}, {_sourcesListPath}). The key is trusted on first use; its
     fingerprint is not pinned.
  3) The dbeaver-ce apt package, from that source.

** Things to know:
  - DBeaver Community Edition is Apache 2.0 licensed.
  - It collects anonymous usage statistics by default (no connection settings, queries or
    database contents, per the project). It is switched off per user, in DBeaver, under
    Window > Preferences > General > Usage Statistics. This sbom does not change it.
  - DBeaver connects over TCP by default. Reaching the cluster by peer authentication over the
    unix socket needs junixsocket driver properties on the connection; see AI-WorkPlan.org 1.10.

** This sbom is run by dbClients-sbom.pcs, after its own steps:
       dbeaver-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*DBeaver Command Examples*')

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("dbeaver-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal("apt-cache policy dbeaver-ce")
    literal("dpkg -l dbeaver-ce")

    cs.examples.menuChapter('*End-Of DBeaver Command Examples*')
    return cmndOutcome
