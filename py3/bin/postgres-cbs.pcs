#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.postgres/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
postgres-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
bedrock: A capability other capabilities are built on --- not a Service Component of its own.
         PostgreSQL is the sole database of BISOS; airflow, django-based packages
         and others are its tenants.
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle is the sbom alone. There is no assemble step (no .here fqdn, no web
vhost) and no systemd unit is authored here: Debian's postgresql.service is
used as is. Tenants declare their dependency with Requires=/After=
postgresql.service in their own units.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed


cba_seed.setup(
    seedType="bedrock",
    loader=None,
    sbom="postgres-sbom.pcs",
    assemble=None,
    materialize=None,
)

# No units: the sysd seed is only the host of the generic cbs_* verbs.
cba_sysd_seed.setup(
    sysdUnitsList=[],
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
