#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.postgres/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
postgres-sbom.pcs: software bill of materials of the PostgreSQL bedrock capability.
It installs the server and the client development headers, and makes sure the
cluster is running with a connection baseline fit for many co-existing tenants.
It provisions no tenant (role + database): that belongs to each consumer for now,
see the readme Cmnd and AI-WorkPlan.org.
#+end_org """

import pathlib

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")

ap = pkgsSeed.aptPkg
sbom = pkgsSeed.sbomSpec

_binDir = pathlib.Path(__file__).resolve().parent

# Baseline every tenant may assume. Server-wide, so it is owned here and not by
# any one consumer: each tenant capability holds its own connection pools.
_maxConnections = 200


def postgresClusterSetup():
    """Make sure the cluster is running with the bedrock baseline. Not an apt package.

    Registered in aptPkgsList as a func-bearing pseudo-package, so sbom_csu's
    aptPkgs_update() calls this instead of apt-get install. Its gate can never be
    true, so this runs on *every* sbom_fullUpdate and must stay idempotent.

    Ordering in aptPkgsList is load-bearing: it must come after ap("postgresql").
    The administrator is the postgres OS account (Debian creates it with the
    package, and the default pg_hba.conf maps it to the postgres role by peer
    authentication). Nothing here touches any tenant's role or database.
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        f"""
# 1. Cluster must be running. Debian's postgresql-common starts it at install
#    time --- except under policy-rc.d (containers), where it silently does not.
#    Version/cluster are discovered, not hardcoded, so a major-version bump of
#    the postgresql metapackage does not strand this.
sudo systemctl enable postgresql >/dev/null 2>&1 || true
read PGVER PGCLUSTER <<< "$(pg_lsclusters -h | awk 'NR==1 {{print $1, $2}}')"
sudo pg_ctlcluster "$PGVER" "$PGCLUSTER" start 2>/dev/null || true

# 2. Connection baseline. ALTER SYSTEM needs a restart to take effect, so only
#    do both when the value is actually low --- otherwise every sbom run bounces
#    the DB under every tenant.
PGMAXCONN=$(sudo -u postgres psql -tAc "show max_connections")
if [ "$PGMAXCONN" -lt {_maxConnections} ] ; then
    sudo -u postgres psql -c "ALTER SYSTEM SET max_connections = {_maxConnections}" >/dev/null
    sudo pg_ctlcluster "$PGVER" "$PGCLUSTER" restart
fi
""")
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


aptPkgsList = [
    ap("postgresql"),               # Server, client and the postgres OS account / role
    ap("libpq-dev"),                # Client development headers, for tenants that build drivers
    ap("postgresClusterSetup", func=postgresClusterSetup),
]

# No pip packages: drivers (psycopg2, asyncpg, ...) install into each consumer's
# own virtenv, through that consumer's sbom.

# Sub-sbom specs run after the apt, pip and pipx steps above, so the server and the cluster
# are in place first. dbClients-sbom.pcs is the group sbom of the database clients (psql, and the
# graphical DBeaver through its own sbom); it stands alone, for hosts that need only clients. Each
# is run as `<name> -i sbom_fullUpdate`, so it is named by the path of the directory this file is
# in, which does not depend on the package being installed or on PATH.
sbomsList = [
    sbom(str(_binDir / "dbClients-sbom.pcs")),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
    sbomsList=sbomsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: PostgreSQL -- the bedrock database of BISOS. Every capability that needs
   a database (airflow, django-based packages, ...) is a tenant of this one cluster.

** What this installs:
  1) apt packages: postgresql (server, client, the postgres OS account and role)
     and libpq-dev (client development headers).
  2) The postgresClusterSetup pseudo-package: the cluster is enabled and running,
     and max_connections is at least {_maxConnections}.

** What this does NOT do:
  - It does not author a systemd unit. Debian's postgresql.service is used as is.
  - It does not provision tenants. A tenant is a role plus a same-named database,
    reached by peer authentication from the like-named OS account, over the
    unix socket, with no password. For now each consumer creates its own; a
    shared role/db provisioning interface is an open item in AI-WorkPlan.org.
  - It installs no Python drivers; those belong to each consumer's sbom.

** Also part of the bedrock capability, run after the steps above through sbomsList:
  - dbClients-sbom.pcs: the database clients (psql; and DBeaver through dbeaver-sbom.pcs).
    It stands alone, for hosts that need only clients.

** Materialization: this sbom is part of the bedrock CBS, see postgres-cbs.pcs.
   The CBM walker handles the bedrock capabilityType before the others.
       postgres-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*PostgreSQL Command Examples*')

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("postgres-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal("pg_lsclusters")
    literal("sudo -u postgres psql -tAc 'show max_connections'")
    literal("systemctl status postgresql.service")

    cs.examples.menuChapter('*End-Of PostgreSQL Command Examples*')
    return cmndOutcome
