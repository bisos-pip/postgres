#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.postgres/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
dbClients-sbom.pcs: the group sbom of the database clients of the bedrock capability. It
installs the psql command-line client, and pulls in dbeaver-sbom.pcs, the optional graphical
client, through its sbomsList. A group of this kind has a precedent in ai-tools-sbom.pcs.

It is independent of the server: a user's edge platform may need the clients to reach a
cluster on another host, with no local server. postgres-sbom.pcs pulls this sbom in, so a host
that runs the server gets the clients too.
#+end_org """

import pathlib

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")

ap = pkgsSeed.aptPkg
sbom = pkgsSeed.sbomSpec

# A sub-sbom is run as `<name> -i sbom_fullUpdate` by bare shell command. Naming it by the path of
# the directory this file is in does not depend on the package being installed or on PATH.
_binDir = pathlib.Path(__file__).resolve().parent

aptPkgsList = [
    ap("postgresql-client"),        # psql, the baseline client: peer authentication, no password
]

# Sub-sbom specs run after the apt, pip and pipx steps above. dbeaver-sbom.pcs is a file of its
# own for failure isolation and for the trust of a third-party package source.
sbomsList = [
    sbom(str(_binDir / "dbeaver-sbom.pcs")),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
    sbomsList=sbomsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = """\
** Scope: the database clients of the bedrock capability. Part of bisos.postgres.

** What this installs:
  1) apt package: postgresql-client (the psql command-line client).
  2) Through sbomsList, after step 1: dbeaver-sbom.pcs, the DBeaver Community Edition graphical client.

** Standalone: this sbom does not need the server. A user's platform may need only the clients,
   to reach a cluster on another host. postgres-sbom.pcs pulls this sbom in, so a host that runs
   the server gets the clients too.

** Not installed here: the VS Code extension of Microsoft's PostgreSQL client (installed per
   user, inside VS Code; the code package comes from vscode-sbom.pcs), and Emacs tooling (comes
   with Blee).

** To run:
       dbClients-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Database Clients Command Examples*')

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("dbClients-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal("psql --version")
    literal("apt-cache policy dbeaver-ce")

    cs.examples.menuChapter('*End-Of Database Clients Command Examples*')
    return cmndOutcome
